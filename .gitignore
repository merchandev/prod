# ============================================================
# Espressivo / Diario El Oriental — .gitignore
# ============================================================

# --- Dependencias ---
node_modules/
# vendor/  (Comentado para incluir dompdf en el repositorio)

# --- Variables de entorno (NUNCA versionar) ---
.env
.env.*
!.env.example
.env.local
.env.production

# --- Artefactos de construcción ---
build/
dist/
coverage/

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Icon?

# --- IDEs y editores ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
php_errorlog
debug.log

# --- Archivos temporales y de trabajo ---
*.tmp
*.temp
temp_*
tmp/
temp_zip/

# --- Parches y diffs de trabajo ---
*.patch
*.diff
diff*.txt
patch_*.txt
main.patch
extracted_part.txt

# --- Scripts de trabajo temporales ---
extract_*.js
fix_css*.js
restore_css*.js
fix_newlines.js

# --- Archivos de prueba con posibles credenciales ---
test_*.php
temp_*.html
temp_*.php

# --- ZIPs / binarios pesados (usar releases o storage externo) ---
*.zip
*.tar.gz
*.tar.bz2

# --- PHP / WordPress ---
.phpunit.result.cache
.phpunit.cache/
phpunit.xml.bak
wp-config.php
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
sitemap.xml
sitemap_index.xml

# --- NPM / Node ---
npm-debug.log
.npm
.yarn-integrity
.pnp.*
.pnp.js

# --- Secrets scanner output ---
gitleaks-report.*
trufflehog-results.*
